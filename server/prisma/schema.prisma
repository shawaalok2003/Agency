generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String        @id @default(uuid())
  name               String?
  email              String        @unique
  passwordHash       String
  role               Role          @default(TEAM_MEMBER)
  companyName        String?       @default("dhandaeasy")
  department         String?       @default("MANAGEMENT")
  phone              String?
  plan               Plan          @default(FREE)
  trialEndsAt        DateTime?
  stripeCustomerId   String?
  subscriptionStatus String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  contacts           Contact[]
  leads              Lead[]
  projects           Project[]
  dailyReports       DailyReport[]
}

model Project {
  id                String        @id @default(uuid())
  name              String
  clientEmail       String?
  clientAccessParam String        @unique @default(uuid())
  userId            String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  status            ProjectStatus @default(ACTIVE)
  deliverables      Deliverable[]
  invoices          Invoice[]
  user              User          @relation(fields: [userId], references: [id])
  scopes            Scope[]
  tasks             Task[]
}

model Scope {
  id        String   @id @default(uuid())
  projectId String
  version   Int      @default(1)
  content   String
  price     Decimal  @default(0.00) @db.Decimal(10, 2)
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
}

model Deliverable {
  id        String             @id @default(uuid())
  projectId String
  version   Int
  fileUrl   String
  notes     String?
  createdAt DateTime           @default(now())
  approvals ApprovalAuditLog[]
  project   Project            @relation(fields: [projectId], references: [id])
}

model ApprovalAuditLog {
  id            String      @id @default(uuid())
  deliverableId String
  action        String
  comments      String?
  performedBy   String      @default("CLIENT")
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime    @default(now())
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id])
}

model Invoice {
  id                String        @id @default(uuid())
  projectId         String
  amount            Decimal
  status            InvoiceStatus @default(DRAFT)
  stripePaymentLink String?
  dueDate           DateTime?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  project           Project       @relation(fields: [projectId], references: [id])
  payments          Payment[]
}

model Payment {
  id            String   @id @default(uuid())
  invoiceId     String
  amount        Decimal
  transactionId String?
  status        String
  createdAt     DateTime @default(now())
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
}

model Lead {
  id               String     @id @default(uuid())
  name             String
  company          String?
  email            String?
  phone            String?
  value            Decimal    @default(0.00) @db.Decimal(10, 2)
  status           LeadStatus @default(NEW)
  assignedToEmail  String?
  assignedToName   String?
  notes            String?
  priority         String?    @default("MEDIUM")
  ownerId          String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  owner            User       @relation(fields: [ownerId], references: [id])
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  role      String?
  company   String?
  email     String
  type      String   @default("CLIENT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model TeamMember {
  id               String   @id @default(uuid())
  name             String
  role             String
  email            String   @unique
  avatarUrl        String?
  department       String?  @default("SALES")
  phone            String?
  status           String   @default("ACTIVE")
  companyName      String?  @default("dhandaeasy")
  projectsCount    Int      @default(0)
  leadsAssigned    Int      @default(0)
  dealsClosed      Int      @default(0)
  revenueGenerated Decimal  @default(0.00) @db.Decimal(12, 2)
  rating           Decimal  @default(5.0) @db.Decimal(2, 1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
}

model Task {
  id        String    @id @default(uuid())
  projectId String
  title     String
  status    String    @default("TODO")
  assignee  String?
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  subtasks  Subtask[]
  project   Project   @relation(fields: [projectId], references: [id])
}

model Subtask {
  id        String  @id @default(uuid())
  taskId    String
  title     String
  completed Boolean @default(false)
  task      Task    @relation(fields: [taskId], references: [id])
}

model DailyReport {
  id               String   @id @default(uuid())
  userId           String
  userName         String
  userEmail        String
  userRole         String   @default("SALES")
  department       String   @default("SALES")
  date             DateTime @default(now())
  tasksCompleted   String
  callsMade        Int      @default(0)
  meetingsBooked   Int      @default(0)
  leadsContacted   Int      @default(0)
  dealsClosedValue Decimal  @default(0.00) @db.Decimal(12, 2)
  blockers         String?
  proofUrl         String?
  status           String   @default("SUBMITTED")
  adminFeedback    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])
}

model TeamMessage {
  id               String   @id @default(uuid())
  channel          String   @default("general")
  senderId         String
  senderName       String
  senderEmail      String
  senderRole       String
  senderDepartment String   @default("SALES")
  recipientEmail   String?
  content          String
  attachmentUrl    String?
  companyName      String   @default("dhandaeasy")
  createdAt        DateTime @default(now())
}

enum Role {
  OWNER
  ADMIN
  SALES
  DEVELOPER
  DESIGNER
  OPERATIONS
  TEAM_MEMBER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

enum Plan {
  FREE
  PRO
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum LeadStatus {
  NEW
  DISCUSSION
  PROPOSAL
  WON
  LOST
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}
